module(
    name = "fintools_public",
    version = "0.0.0",
)

# repo_name keeps the historical @io_bazel_rules_go / @bazel_gazelle labels
# working in the existing BUILD files.
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "protobuf", version = "35.1")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_aclindsa_ofxgo", "com_github_google_uuid", "com_github_davecgh_go_spew", "com_github_golang_glog", "com_github_google_go_cmp", "com_github_llgcode_draw2d", "com_github_pkg_errors")
